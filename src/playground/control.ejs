<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8">
    <!-- Plantilla propia y no la del editor: un mando necesita que el zoom por
         doble toque esté apagado (si no, pulsar rápido dos veces amplía la
         pantalla en vez de mover el robot) y que el área útil llegue debajo del
         notch en los celulares con muesca. -->
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#14181F">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="google" value="notranslate">
    <link rel="shortcut icon" href="static/favicon.ico">
    <title><%= htmlWebpackPlugin.options.title %></title>
  </head>
  <body>
  </body>
</html>
